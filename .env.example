# ============================================================================
#  Eureka Forbes — Social Chat Agent
#  Copy to .env and fill in. No Postgres, no Redis: state lives in SQLite.
# ============================================================================

# ── Runtime ─────────────────────────────────────────────────────────────────
APP_ENV=development          # development enables per-session debug logs
PORT=8000
LOG_LEVEL=INFO
ADMIN_API_KEY=change-me      # guards /admin/* and /session/* endpoints

# ── Session store (SQLite) ──────────────────────────────────────────────────
EF_DB_PATH=./data/ef_chat.db
SESSION_TTL_DAYS=2           # sessions/messages older than this are purged
SUMMARY_BATCH_SIZE=5         # rolling summary every N user messages
SUMMARY_TIMEOUT_SECONDS=15   # longest a turn will wait on an in-flight summary

# ── LLM (Azure OpenAI, v1-compatible endpoint) ──────────────────────────────
# The endpoint must be the BASE url ending in /openai/v1 — not the
# /openai/responses?api-version=... url, which 404s every call.
LLM_PROVIDER=azure_openai
AZURE_LLM_ENDPOINT=https://<resource>.cognitiveservices.azure.com/openai/v1
AZURE_LLM_API_KEY=
AZURE_LLM_MODEL=gpt-5.6-sol
MAX_OUTPUT_TOKENS=4096
# Leave empty for gpt-5.x reasoning models (they reject anything but the default).
LLM_TEMPERATURE=
# Model for the background rolling summary + interaction classification.
# Defaults to AZURE_LLM_MODEL.
SUMMARY_MODEL=

# ── Interaction logging ─────────────────────────────────────────────────────
INTERACTION_IDLE_SECONDS=300      # 5 min quiet before a conversation is logged to the CRM
INTERACTION_SCAN_SECONDS=30       # how often to look for quiet conversations
INTERACTION_ORPHAN_HOURS=24       # hold an unidentified chat this long before logging it unlinked
COST_PER_1K_INPUT=                # optional: fills ef_costamount from token usage
COST_PER_1K_OUTPUT=

# ── Eureka Forbes Dataverse (CRM) ───────────────────────────────────────────
DATAVERSE_URL=https://eurekaforbesdemo.crm8.dynamics.com
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_API_VERSION=v9.2
# EF_SCHEMA_FILE=./ef_schema_reference.json   # override only if it moves

# ── Brand knobs the prompts read ({{brand_name}} etc.) ──────────────────────
BRAND_NAME=Eureka Forbes
AGENT_NAME=Asha
SUPPORT_NUMBER=+918049280357

# ── WhatsApp Business Cloud API ─────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=            # needed only for creating/checking message templates
WHATSAPP_VERIFY_TOKEN=

# ── Facebook Messenger ──────────────────────────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_VERIFY_TOKEN=

# ── Instagram DM ────────────────────────────────────────────────────────────
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=

# ── AMC renewal reminders (proactive WhatsApp templates) ────────────────────
# OFF by default. A background sender that switches itself on during a deploy is
# not something you want to find out about from a customer.
AMC_REMINDERS_ENABLED=false
AMC_REMINDER_HOUR_IST=12          # daily run time, 24h clock, Asia/Kolkata
AMC_REMINDER_MINUTE_IST=0
AMC_REMINDER_MAX_PER_RUN=200      # hard cap per run, whatever the CRM returns
AMC_REMINDER_SPACING_SECONDS=1.0  # gap between sends
AMC_RENEWAL_OFFER_PCT=10          # the discount the agent may state
# Only these numbers get reminders. Empty = the job refuses to send unless
# AMC_REMINDER_ALLOW_FULL_CRM is also true. Comma-separated.
AMC_REMINDER_ALLOWLIST=
AMC_REMINDER_ALLOW_FULL_CRM=false

# ── Renewal plan pricing ────────────────────────────────────────────────────
# The figures in chatbot/client/amc_plans.py are PLACEHOLDERS from a mockup.
# Replace them with EF's real card rates, then set this to true. While it is
# false the agent names plans and the discount but quotes no rupee amount.
AMC_PRICES_CONFIRMED=false
